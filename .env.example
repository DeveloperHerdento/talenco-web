# Every environment variable the code reads, with a comment and a dummy value (HGS-STD 5.3).
# Copy to .env and fill in real values. Never commit .env.
# lib/env.ts throws at import time when a required server variable is missing.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service-role key, server-only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit (required) ---
# Secret key with money-in scope (xnd_development_... locally, xnd_production_... in prod)
XENDIT_SECRET_KEY=
# HMAC secret peeka (peekainsight.com) uses when it relays Xendit webhooks; must equal TALENCO_FORWARD_SECRET in peeka
PEEKA_FORWARD_SECRET=

# --- payment-service (required) ---
# Base URL of payment-service; key and secret are printed by `npm run app:create` in payment-service
PAYMENT_SERVICE_URL=http://127.0.0.1:4000
PAYMENT_APP_KEY=pk_talenco_xxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxx

# --- Resend email (required) ---
RESEND_API_KEY=re_xxxx
# Sender address on a domain verified in Resend
RESEND_FROM_EMAIL=noreply@example.com
# Optional: payment reconciliation problems are emailed here (see lib/alerts.ts); empty = log only
OPS_ALERT_EMAIL=

# --- Upstash Redis rate limiting (required; skipped in NODE_ENV=development) ---
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile ---
# Required server secret (Cloudflare test secret shown)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional public site key; leave empty to use the dev-bypass path
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Admin panel (required) ---
# Single shared password for /admin, no user accounts
ADMIN_PASSWORD=

# --- App ---
# Public site URL (required); production: the real domain
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional: your ngrok domain for local webhook testing, e.g. foo.ngrok-free.dev (next.config.ts)
DEV_ALLOWED_ORIGIN=

# --- Docker compose only (server .env; see docs/DEPLOYMENT.md) ---
# COMPOSE_PROJECT_NAME=talenco-web-staging
# Image to run, tagged per build
# IMAGE=ghcr.io/developerherdento/talenco-web:staging-<sha>
# Host port; compose binds it to 127.0.0.1 only and nginx proxies to it
# PORT=8001
