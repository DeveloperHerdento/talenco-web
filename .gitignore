# Dependencies and build output (rebuilt from lockfiles / CI)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets: only the template is versioned
.env*
!.env*.example
*.pem
secrets/

# Hosting
.vercel
.netlify

# Archives and OS junk
*.zip
*.rar
.DS_Store
Thumbs.db

# Personal notes and AI tool state
.local/
docs/notes/
/.claude/
/backup/*

# Client PDFs (guideline book, T&C, exported dev doc) stay out of git until the owner decides
docs/**/*.pdf

# Local-only data exports (Supabase table dumps, etc.) — never belongs under public/, which
# Next.js serves as static files with no auth check. Keep exports here instead.
/.local-data/
public/**/*.csv

# Docs are kept outside git (owner decision 2026-11-17, deviates from HGS-STD 10.1)
/docs/
